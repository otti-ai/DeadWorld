<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>DeadWorld_ZombieInfection</defName>
    <label>zombie infection</label>
    <description>A zombie infection that starts in one wounded body part and spreads slowly. If it reaches the head or torso, it becomes systemic throughout the body. After the configured incubation period, the infected pawn dies and reanimates. If killed by another cause first, it reanimates immediately.</description>
    <hediffClass>DeadWorld.Hediff_ZombieInfection</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <duplicationAllowed>true</duplicationAllowed>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <becomeVisible>false</becomeVisible>
        <label>localized</label>
      </li>
      <li>
        <minSeverity>0.34</minSeverity>
        <becomeVisible>false</becomeVisible>
        <label>spreading</label>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <becomeVisible>false</becomeVisible>
        <label>advanced</label>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DeadWorld_ZombieInfectionSystemic</defName>
    <label>systemic zombie infection</label>
    <description>The infection has reached the head or torso and is now systemic throughout the body. It cannot be cured. If the pawn dies first, it reanimates immediately.</description>
    <hediffClass>DeadWorld.Hediff_ZombieInfection</hediffClass>
    <initialSeverity>0.001</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <becomeVisible>false</becomeVisible>
        <label>systemic</label>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <becomeVisible>false</becomeVisible>
        <label>terminal</label>
      </li>
    </stages>
    <comps>
      <li Class="DeadWorld.HediffCompProperties_BitingFrenzy" />
    </comps>
  </HediffDef>
</Defs>